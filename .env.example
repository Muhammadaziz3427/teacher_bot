# ===== Telegram bot =====
# Token obtained from @BotFather
BOT_TOKEN=123456789:AAExampleToken

# Allowed chat types: group, supergroup, private
BOT_ALLOWED_CHAT_TYPES=group,supergroup,private

# ===== AI provider (any OpenAI-compatible API) =====
# OpenAI / DeepSeek / OpenRouter / Gemini proxy / local Ollama or LM Studio
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini      # must support images (homework photos)
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1600
AI_REQUEST_TIMEOUT=90
AI_ENABLED=true

# One-tap confirmations: when a student sends homework the bot stores it
# and waits for the student's own ✅ button before AI checking starts.
CONFIRM_SUBMISSIONS=false

# Voice answers (speech-to-text). STT_API_KEY/STT_BASE_URL empty = reuse
# OPENAI_API_KEY/OPENAI_BASE_URL. OpenRouter serves audio on the same base URL
# but asks for a small minimum audio balance; then set STT_MODEL=openai/whisper-1
STT_MODEL=whisper-1
STT_API_KEY=
STT_BASE_URL=

# Deep links need the bot's @username for t.me/<bot>?start=parent_<chat>_<id>
BOT_USERNAME=

# Mini App dashboard (Telegram Web App, optional)
# Set MINIAPP_PUBLIC_URL to your https address (e.g. an ngrok tunnel) and add
# the bot's admin panel button via: /app
MINIAPP_ENABLED=false
MINIAPP_HOST=127.0.0.1
MINIAPP_PORT=8080
MINIAPP_TOKEN=
MINIAPP_PUBLIC_URL=

# ===== Roles =====
# Admins: full control, can promote/demote teachers
ADMIN_IDS=111111111
# Extra teachers (teachers can also be assigned inside the bot)
TEACHER_IDS=222222222

# ===== General =====
TZ=Asia/Tashkent
DB_FILE=data/teacher_bot.db
EXPORTS_DIR=data/exports
DEFAULT_SUBJECT=English
TARGET_LANGUAGE=English
# If no timetable is set, the deadline is this many hours away
DEFAULT_DUE_HOURS=24
# Reminder times before the deadline, in hours
REMINDER_HOURS=24,1

# Automatically post the group weekly report (sun 20:00 by default)
AUTO_WEEKLY_REPORT=true
AUTO_WEEKLY_DAY=sun
AUTO_WEEKLY_HOUR=20

# ===== Points / penalties (tune freely) =====
POINT_FULL=2
POINT_PARTIAL=1
POINT_WRONG=0
POINT_LATE=-1
POINT_MISSING=-3
POINT_ABSENT=-1
POINT_LATE_ATTENDANCE=-0.5
# Does a late submission earn only half of its points?
LATE_HALVES_SCORE=true
